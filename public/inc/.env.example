# Copy this file to `.env` in the same folder (public/inc/.env) and fill in
# real values. `.env` is gitignored — never commit real credentials.
#
# On Hostinger: create a MySQL database in hPanel (Databases -> MySQL
# Databases), then fill DB_HOST/DB_NAME/DB_USER/DB_PASS below with the
# values it gives you (DB_HOST is almost always "localhost" on shared
# hosting). Run sql/schema.sql once via phpMyAdmin against that database.

# --- Database ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- Business ---
BUSINESS_TIMEZONE=America/Toronto
TO_EMAIL=info@gstruckrepair.ca
FROM_EMAIL=info@gstruckrepair.ca

# --- Mail driver ---
# php_mail = send via PHP's mail() (default, works out of the box on Hostinger)
# log      = write emails to public/inc/mail.log instead of sending (testing only)
MAIL_DRIVER=php_mail

# --- Cron ---
# Random long string. Required as ?key=... (HTTP) or first CLI argument
# when triggering public/cron/send-reminders.php.
CRON_SECRET=

# --- Admin panel ---
# bcrypt hash of the admin password — generate with:
#   php -r "echo password_hash('your-password', PASSWORD_BCRYPT), PHP_EOL;"
ADMIN_PASSWORD_HASH=

# --- Testing only ---
# When set to a valid PHP date string, the cron script treats this as
# "now" instead of the real current time. Never set this in production.
# TEST_NOW=
